{
  "name": "qadmin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:migrate && npm run obfuscate && next build",
    "start": "next start",
    "lint": "eslint",
    "obfuscate": "node scripts/script.js",
    "db:generate": "drizzle-kit generate --config=drizzle.config.cjs",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.cjs"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.44.5",
    "jsonwebtoken": "^9.0.2",
    "next": "16.4.2",
    "pg": "^8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "javascript-obfuscator": "^5.9.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
